# Connection string for Evi's store (Neon Postgres via the Vercel
# Marketplace). Pull real values with `vercel env pull` in apps/evi — the
# integration sets POSTGRES_URL / POSTGRESQL_URL, and DATABASE_URL is the
# plain name also recognised. Unset everything to run locally DB-free:
# `isDbConfigured()` returns false and DB-backed features degrade cleanly.
# DATABASE_URL=postgres://user:password@host:5432/db
